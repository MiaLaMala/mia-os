<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Der gemeinsame Ablageort von App, Widget und Uhr. Ohne ihn liest
         jede Erweiterung ihren eigenen, immer leeren Speicher. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.dev.mia-gruenwald.mia-os</string>
    </array>
</dict>
</plist>
