# --- Server ---
HOST=0.0.0.0
PORT=8080
DB_PATH=/var/lib/mia-os/mia-os.db
COLLECT_INTERVAL_MINUTES=60

# --- Gesundheit: wger ---
WGER_URL=http://wger.example.invalid:8000
WGER_TOKEN=

# --- Termine: iCloud CalDAV ---
CALDAV_URL=https://caldav.icloud.com
CALDAV_USER=
CALDAV_PASSWORD=

# --- Homelab: Proxmox ---
PROXMOX_URL=https://proxmox.example.invalid:8006
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=

# --- Homelab: Uptime Kuma ---
KUMA_URL=http://kuma.example.invalid:3001

# --- Ausbildung: Moodle ---
MOODLE_URL=
MOODLE_TOKEN=

# --- OCR: Text aus selbst gescannten Belegen ---
# Nur fuer Belege, die durch den Scanner gelaufen sind. Fuer den Bestand wird
# kein Text gelesen und keiner gespeichert.
#
# Im Container liegt tesseract im PATH und die Sprachdateien an der
# Standardstelle, dort bleiben die beiden Pfade leer. Auf einem Rechner, wo
# tesseract ohne root entpackt wurde, zeigen sie auf das Entpackverzeichnis.
OCR_BINARY=tesseract
OCR_TESSDATA=
OCR_LIB_PATH=
OCR_SPRACHE=deu+eng
OCR_TIMEOUT=60

# --- Ordnervorschlag: Embedding-Server auf LXC 140 ---
# Schlaegt beim Hochladen vor, in welchen Sachordner ein Beleg gehoert.
# Verglichen werden Dateinamen aus dem Index, dazu der OCR-Text des Belegs
# selbst. Alles bleibt im Heimnetz.
#
# Leer heisst aus: dann gibt es keinen Vorschlag und sonst nichts.
EMBED_URL=http://embed.example.invalid:8080
EMBED_MODEL=embeddinggemma
EMBED_TIMEOUT=30
