# MCP-Server
mcp/.venv/
mcp/uv.lock

# Apple: von XcodeGen und Xcode erzeugt, nicht von Hand geschrieben.
# Die Quelle ist apple/project.yml, daraus entsteht das Projekt neu.
apple/MiaOS.xcodeproj/
apple/MiaOSMac/Info.plist
# NUR die erzeugte Info.plist, nicht der ganze Ordner.
#
# Hier stand bis zum 14.09.2026 `apple/MiaOSiOS/`, und damit fehlte die
# handgeschriebene MiaOS.entitlements im neuen Repo: sie wurde beim Umzug
# nie mitkopiert. Der Build brach auf Mias Mac ab mit "The file
# MiaOSiOS/MiaOS.entitlements could not be opened". Aufgefallen erst beim
# ersten echten Bau aufs Gerät, weil `swiftc -typecheck` keine
# Projektdateien anfasst.
apple/MiaOSiOS/Info.plist
apple/.build/
apple/build*/
apple/Payload/
apple/*.ipa
apple/*.zip
apple/*.sha256
# Das App-Symbol entsteht aus scripts/symbol_zeichnen.py. Eine PNG im Git
# ist eine Datei, die niemand nachvollziehen kann.
apple/MiaOS/Assets.xcassets/AppIcon.appiconset/*.png

# Brainstorm-Server: Entwuerfe und Zustand, nichts davon gehoert ins Repo.
.superpowers/
