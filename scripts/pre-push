#!/usr/bin/env bash
# Pre-Push-Hook: hält einen Push auf, der die CI rot machen würde.
#
# Mias Ansage am 09.09.2026: "Kannst du darauf achten, dass ich keine Fehler
# mehr bekomme?" Ein Skript, an das ich denken muss, reicht dafür nicht.
# Neun fehlgeschlagene Läufe sind entstanden, weil ich in genau dem Moment
# an etwas anderes gedacht habe.
#
# Notausgang: `git push --no-verify`. Bewusst vorhanden, aber dann ist es
# eine Entscheidung und kein Versehen.

set -uo pipefail
WURZEL="$(git rev-parse --show-toplevel)"

# Nur main schützen. Auf einem Zweig soll Ausprobieren möglich bleiben, und
# die CI schickt für Zweige ohnehin keine Fehlermail.
ZIEL_IST_MAIN=0
while read -r _lokal _lokal_sha fern _fern_sha; do
    case "$fern" in refs/heads/main) ZIEL_IST_MAIN=1 ;; esac
done
[ "$ZIEL_IST_MAIN" -eq 1 ] || exit 0

echo "Prüfe vor dem Push, was die CI prüfen wird…"
if bash "$WURZEL/scripts/vor_dem_push.sh"; then
    exit 0
fi

cat >&2 <<'ENDE'

Push abgebrochen. Ein roter CI-Lauf schickt Mia eine Mail.
Erst beheben, dann erneut pushen. Im Notfall: git push --no-verify
ENDE
exit 1
